# ============================================================
# LLM 配置模板 — 复制为 .env 后填入你自己的值
# ⚠️ .env 已在 .gitignore 中，勿提交
# ⚠️ Key 严禁明文贴入对话 / 截图 / Issue
# ============================================================

# API Key（Nebula 后台 → 令牌管理 → 生成）
OPENAI_API_KEY=your-nebula-api-key-here

# OpenAI 兼容网关地址
OPENAI_BASE_URL=https://hub.shhdpz.cn

# 模型名
OPENAI_MODEL=gpt-5.5

# LLM 模式：auto = 有 Key 走真实模型，无 Key 降级 Mock；mock = 强制 Mock
LLM_MODE=auto
